# Model provider
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=google_genai:gemma-4-31b
GOOGLE_FAST_MODEL=google_genai:gemma-3-12b

# Tool APIs
TAVILY_API_KEY=your_tavily_key_here
OPENWEATHERMAP_API_KEY=your_owm_key_here

# Application
APP_ENV=development              # Set to 'production' for persistent checkpointing
CHECKPOINT_DB=./data/sessions.db # SQLite path (production only)

# Observability (optional but recommended)
# LANGSMITH_API_KEY=your_langsmith_key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=travel-planner-agent
